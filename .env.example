# Strophic - environment reference.
# Copy what each app needs into that app's own .env / .dev.vars (never commit real values).
# Full documentation lives in docs/env.md (added in Phase 6).

# ──────────────────────────────────────────────────────────────────────────
# Database (Neon Postgres) - Phase 1
# ──────────────────────────────────────────────────────────────────────────
# Pooled endpoint (…-pooler…): used by the Worker/API at runtime via the Neon driver adapter.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/strophic?sslmode=require"
# Direct (non-pooled) endpoint: used ONLY by Prisma CLI/CI for migrations (PgBouncer can't run DDL).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/strophic?sslmode=require"

# ──────────────────────────────────────────────────────────────────────────
# Auth - Phase 1
# ──────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="generate-a-long-random-secret"
JWT_REFRESH_SECRET="generate-a-different-long-random-secret"
COOKIE_DOMAIN=".strophic.in"

# ──────────────────────────────────────────────────────────────────────────
# Email (Resend at launch; provider-abstracted) - Phase 1/3
# ──────────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER="resend"
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Strophic <hafeez@strophic.in>"
CONTACT_NOTIFY_EMAIL="hafeez@strophic.in"

# ──────────────────────────────────────────────────────────────────────────
# Storage (Supabase Storage - S3-compatible) - Phase 1/4
# Create S3 access keys: Supabase dashboard → Storage → Settings → "S3 access keys".
# These are server-side only (full access, bypass RLS) - treat as secrets.
# ──────────────────────────────────────────────────────────────────────────
SUPABASE_STORAGE_ENDPOINT="https://<project-ref>.storage.supabase.co/storage/v1/s3"
SUPABASE_STORAGE_REGION="us-east-1"
SUPABASE_STORAGE_ACCESS_KEY_ID=""
SUPABASE_STORAGE_SECRET_ACCESS_KEY=""
SUPABASE_STORAGE_BUCKET="media"
SUPABASE_STORAGE_PUBLIC_URL="https://<project-ref>.supabase.co/storage/v1/object/public/media"

# ──────────────────────────────────────────────────────────────────────────
# Public URLs (build-time) - used by website & admin
# ──────────────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL="https://strophic.in"
PUBLIC_API_URL="https://api.strophic.in"
ADMIN_URL="https://admin.strophic.in"

# ──────────────────────────────────────────────────────────────────────────
# Scheduled jobs (Vercel Cron) - Phase 6
# Set this in the API's Vercel project; Vercel Cron sends it as a Bearer token
# to the cron endpoints (e.g. the daily reminder digest at 08:00 UTC).
# ──────────────────────────────────────────────────────────────────────────
CRON_SECRET="generate-a-long-random-secret"

# Cloudflare Pages "Deploy Hook" URL. The API POSTs to it after content changes
# (and via the admin "Rebuild site" button) so the static website rebuilds and the
# new content goes live automatically. Create it: Cloudflare Pages → project →
# Settings → Builds & deployments → Deploy hooks. Server-side only.
DEPLOY_HOOK_URL="https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/xxxxxxxx"
