---
import type { Project } from "../data/projects";
import Badge from "./Badge.astro";

interface Props {
  project: Project;
}
const { project } = Astro.props;
const gradient = `linear-gradient(135deg, ${project.accent[0]}, ${project.accent[1]})`;
---

<a
  href={`/work/${project.slug}`}
  data-reveal
  class="group flex flex-col overflow-hidden rounded-2xl border border-ink-800/80 bg-ink-900/40 transition-colors hover:border-ink-700"
>
  <div class="relative aspect-[16/10] overflow-hidden" style={`background-image:${gradient}`}>
    <div class="grid-field absolute inset-0 opacity-40"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-ink-950/50 to-transparent"></div>
    <span class="absolute left-4 top-4"><Badge tone="neutral">{project.category}</Badge></span>
    <span class="absolute bottom-4 right-4 font-mono text-xs text-white/70">{project.year}</span>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-lg font-medium text-ink-50 transition-colors group-hover:text-white">
      {project.title}
    </h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-400">{project.summary}</p>
    <div class="mt-4 flex flex-wrap gap-x-3 gap-y-1">
      {project.tags.map((t) => <span class="font-mono text-[0.7rem] text-ink-500">#{t}</span>)}
    </div>
  </div>
</a>
