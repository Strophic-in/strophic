---
import Button from "./Button.astro";
import Container from "./Container.astro";

interface Props {
  title?: string;
  intro?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  title = "Let's build something that ships.",
  intro = "Tell us what you're trying to do. We'll reply with the fastest credible path to get there - usually within one business day.",
  primaryLabel = "Start a project",
  primaryHref = "/contact",
  secondaryLabel = "See our work",
  secondaryHref = "/work",
} = Astro.props;
---

<section class="py-20 sm:py-28">
  <Container>
    <div
      data-reveal
      class="relative overflow-hidden rounded-3xl border border-ink-800 bg-ink-900/50 px-6 py-16 text-center sm:px-16"
    >
      <div class="grid-field absolute inset-0 opacity-50" aria-hidden="true"></div>
      <div
        class="absolute -top-24 left-1/2 h-48 w-[36rem] max-w-full -translate-x-1/2 rounded-full bg-brand-600/20 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div class="relative">
        <h2 class="mx-auto max-w-2xl text-3xl sm:text-4xl">{title}</h2>
        <p class="mx-auto mt-5 max-w-xl text-lg text-ink-400">{intro}</p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <Button href={primaryHref} size="lg">{primaryLabel}</Button>
          <Button href={secondaryHref} variant="outline" size="lg">{secondaryLabel}</Button>
        </div>
      </div>
    </div>
  </Container>
</section>
