---
interface Props {
  items: { question: string; answer: string }[];
}
const { items } = Astro.props;
---

<div class="divide-y divide-ink-800 overflow-hidden rounded-2xl border border-ink-800">
  {
    items.map((item) => (
      <details class="group">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-ink-100 hover:bg-ink-900/40">
          <span class="font-medium">{item.question}</span>
          <span
            class="text-2xl leading-none text-ink-500 transition-transform duration-200 group-open:rotate-45"
            aria-hidden="true"
          >
            +
          </span>
        </summary>
        <p class="px-5 pb-5 text-sm leading-relaxed text-ink-400">{item.answer}</p>
      </details>
    ))
  }
</div>
