---
import { footerNav, site } from "../config/site";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
const socials: { label: string; href: string; icon: string }[] = [
  { label: "Instagram", href: site.social.instagram, icon: "instagram" },
  { label: "X", href: site.social.x, icon: "twitter-x" },
  { label: "LinkedIn", href: site.social.linkedin, icon: "linkedin" },
  { label: "GitHub", href: site.social.github, icon: "github" },
];
---

<footer class="border-t border-ink-900 bg-ink-950">
  <div class="mx-auto w-full max-w-6xl px-6 py-16 lg:px-8">
    <div class="grid gap-12 md:grid-cols-[1.5fr_1fr_1fr]">
      <div class="max-w-sm">
        <a href="/" class="flex items-center gap-2.5" aria-label={`${site.name} home`}>
          <span
            class="grid h-8 w-8 place-items-center rounded-lg bg-brand-500 font-serif text-lg font-semibold text-white"
            >S</span
          >
          <span class="font-serif text-lg font-semibold text-ink-50">{site.name}</span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-ink-400">{site.description}</p>
        <div class="mt-6 flex items-center gap-2">
          {
            socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                class="grid h-9 w-9 place-items-center rounded-lg border border-ink-800 text-ink-400 transition-colors hover:border-ink-600 hover:text-ink-100"
              >
                <Icon name={s.icon} size={18} />
              </a>
            ))
          }
        </div>
      </div>

      {
        footerNav.map((col) => (
          <div>
            <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-ink-500">{col.title}</h2>
            <ul class="mt-4 space-y-3">
              {col.items.map((item) => (
                <li>
                  <a href={item.href} class="text-sm text-ink-300 transition-colors hover:text-ink-50">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-14 flex flex-col items-start justify-between gap-4 border-t border-ink-900 pt-8 text-sm text-ink-500 sm:flex-row sm:items-center"
    >
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>
        <a href="/contact" class="transition-colors hover:text-ink-200">{site.email}</a>
      </p>
    </div>
  </div>
</footer>
