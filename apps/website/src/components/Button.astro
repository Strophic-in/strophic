---
type Variant = "primary" | "secondary" | "ghost" | "outline";
type Size = "sm" | "md" | "lg";

type Props = {
  href?: string;
  variant?: Variant;
  size?: Size;
  class?: string;
} & Record<string, unknown>;

const { href, variant = "primary", size = "md", class: className = "", ...rest } = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-full font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-ink-950 disabled:opacity-50 disabled:pointer-events-none";

const variants: Record<Variant, string> = {
  primary: "bg-brand-500 text-white hover:bg-brand-400",
  secondary: "bg-ink-50 text-ink-950 hover:bg-white",
  ghost: "text-ink-100 hover:bg-ink-800/60",
  outline: "border border-ink-700 text-ink-100 hover:border-ink-500 hover:bg-ink-900/60",
};

const sizes: Record<Size, string> = {
  sm: "h-9 px-4 text-sm",
  md: "h-11 px-5 text-sm",
  lg: "h-12 px-7 text-base",
};

const Tag = href ? "a" : "button";
---

<Tag class:list={[base, variants[variant], sizes[size], className]} href={href} {...rest}>
  <slot />
</Tag>
