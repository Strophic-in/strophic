---
type Tone = "neutral" | "brand" | "amber" | "live";
interface Props {
  tone?: Tone;
  class?: string;
}
const { tone = "neutral", class: className = "" } = Astro.props;

const tones: Record<Tone, string> = {
  neutral: "border-ink-800 bg-ink-900/60 text-ink-300",
  brand: "border-brand-500/30 bg-brand-500/10 text-brand-200",
  amber: "border-amber-500/30 bg-amber-500/10 text-amber-400",
  live: "border-emerald-500/30 bg-emerald-500/10 text-emerald-300",
};
---

<span
  class:list={[
    "inline-flex items-center gap-1.5 rounded-full border px-3 py-1 font-mono text-[0.7rem] uppercase tracking-wider",
    tones[tone],
    className,
  ]}
>
  <slot />
</span>
