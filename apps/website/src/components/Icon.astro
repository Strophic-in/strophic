---
/**
 * Inline SVG icons (lucide-derived, stroke-based) plus filled brand glyphs.
 * Keeps the static pages free of an icon-font or JS dependency.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;

const STROKE: Record<string, string> = {
