---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<p
  class:list={[
    "inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.22em] text-brand-300",
    className,
  ]}
>
  <span class="h-px w-6 bg-brand-400/60" aria-hidden="true"></span>
  <slot />
</p>
