---
import { clampDescription, formatTitle, organizationSchema, websiteSchema } from "@strophic/seo";
import { site } from "../config/site";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  image,
  type = "website",
  noindex = false,
  jsonLd = [],
  publishedTime,
  modifiedTime,
} = Astro.props;

const isHome = Astro.url.pathname === "/";
const canonical = new URL(Astro.url.pathname, site.url).toString();
const fullTitle = formatTitle(title, site.name, isHome);
const desc = clampDescription(description);
const ogImage = new URL(image ?? site.ogImage, site.url).toString();

const baseLd = [
  organizationSchema({
    name: site.name,
    url: site.url,
    logo: new URL("/favicon.svg", site.url).toString(),
    description: site.description,
    email: site.email,
    sameAs: Object.values(site.social),
  }),
  websiteSchema({ name: site.name, url: site.url }),
];
const allLd = [...baseLd, ...jsonLd];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<title>{fullTitle}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta name="theme-color" content="#0a0b14" />
<meta name="generator" content={Astro.generator} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={ogImage} />

<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${site.name} blog`}
  href={new URL("/rss.xml", site.url).toString()}
/>

{allLd.map((obj) => <script type="application/ld+json" is:inline set:html={JSON.stringify(obj)} />)}
