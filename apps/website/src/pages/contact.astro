---
import Container from "../components/Container.astro";
import Icon from "../components/Icon.astro";
import PageHeader from "../components/PageHeader.astro";
import Section from "../components/Section.astro";
import { site } from "../config/site";
import { services } from "../data/services";
import BaseLayout from "../layouts/BaseLayout.astro";

const description =
  "Tell us what you're trying to build. We reply with the fastest credible path — usually within one business day.";

const fieldClass =
  "h-11 w-full rounded-xl border border-ink-700 bg-ink-950 px-4 text-sm text-ink-100 placeholder:text-ink-500 focus-visible:border-brand-400 focus-visible:outline-none";

const socials: { label: string; href: string; icon: string }[] = [
  { label: "Instagram", href: site.social.instagram, icon: "instagram" },
  { label: "X", href: site.social.x, icon: "twitter-x" },
  { label: "LinkedIn", href: site.social.linkedin, icon: "linkedin" },
  { label: "GitHub", href: site.social.github, icon: "github" },
];
---

<BaseLayout title="Contact" description={description}>
  <PageHeader eyebrow="Contact" title="Let's talk about your project" intro={description} />

  <Section>
    <Container>
      <div class="grid gap-12 lg:grid-cols-[1.5fr_1fr]">
        <div>
          <form id="contact-form" class="grid gap-5" novalidate>
            <div class="sr-only" aria-hidden="true">
              <label
                >Leave this field empty
                <input type="text" name="website" tabindex="-1" autocomplete="off" />
              </label>
            </div>
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class="mb-2 block text-sm text-ink-300">Name</label>
                <input id="name" name="name" type="text" required autocomplete="name" class={fieldClass} />
              </div>
              <div>
                <label for="email" class="mb-2 block text-sm text-ink-300">Email</label>
                <input id="email" name="email" type="email" required autocomplete="email" class={fieldClass} />
              </div>
            </div>
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="company" class="mb-2 block text-sm text-ink-300">
                  Company <span class="text-ink-600">(optional)</span>
                </label>
                <input id="company" name="company" type="text" autocomplete="organization" class={fieldClass} />
              </div>
              <div>
                <label for="service" class="mb-2 block text-sm text-ink-300">What do you need?</label>
                <select id="service" name="service" class={fieldClass}>
                  <option value="">Select a service…</option>
                  {services.map((s) => <option value={s.slug}>{s.title}</option>)}
                  <option value="other">Something else</option>
                </select>
              </div>
            </div>
            <div>
              <label for="message" class="mb-2 block text-sm text-ink-300">Tell us about it</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                placeholder="What are you trying to build or fix? What does success look like?"
                class="w-full rounded-xl border border-ink-700 bg-ink-950 px-4 py-3 text-sm text-ink-100 placeholder:text-ink-500 focus-visible:border-brand-400 focus-visible:outline-none"
              ></textarea>
            </div>
            <div class="flex flex-wrap items-center gap-4">
              <button
                type="submit"
                class="inline-flex h-11 items-center justify-center gap-2 rounded-full bg-brand-500 px-6 text-sm font-medium text-white transition-colors hover:bg-brand-400 disabled:opacity-60"
              >
                Send message <Icon name="arrow-right" size={16} />
              </button>
              <p id="contact-msg" class="text-sm text-ink-400" role="status" aria-live="polite"></p>
            </div>
          </form>
        </div>

        <aside class="space-y-8">
          <div class="rounded-2xl border border-ink-800 bg-ink-900/40 p-6">
            <h2 class="text-lg font-medium text-ink-50">Prefer email?</h2>
            <a
              href={`mailto:${site.email}`}
              class="mt-2 inline-flex items-center gap-2 text-brand-300 hover:text-brand-200"
            >
              <Icon name="mail" size={18} />
              {site.email}
            </a>
          </div>
          <div class="rounded-2xl border border-ink-800 bg-ink-900/40 p-6">
            <h2 class="text-lg font-medium text-ink-50">What happens next</h2>
            <ol class="mt-4 space-y-3 text-sm text-ink-400">
              <li class="flex gap-2.5">
                <Icon name="check" size={16} class="mt-0.5 shrink-0 text-brand-400" /> We read your message and reply within one business day.
              </li>
              <li class="flex gap-2.5">
                <Icon name="check" size={16} class="mt-0.5 shrink-0 text-brand-400" /> A short call to understand the problem and constraints.
              </li>
              <li class="flex gap-2.5">
                <Icon name="check" size={16} class="mt-0.5 shrink-0 text-brand-400" /> A clear proposal with scope, timeline, and price.
              </li>
            </ol>
          </div>
          <div class="rounded-2xl border border-ink-800 bg-ink-900/40 p-6">
            <h2 class="text-lg font-medium text-ink-50">Find us</h2>
            <div class="mt-4 flex gap-2">
              {
                socials.map((s) => (
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={s.label}
                    class="grid h-9 w-9 place-items-center rounded-lg border border-ink-800 text-ink-400 transition-colors hover:border-ink-600 hover:text-ink-100"
                  >
                    <Icon name={s.icon} size={18} />
                  </a>
                ))
              }
            </div>
          </div>
        </aside>
      </div>
    </Container>
  </Section>
</BaseLayout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const msg = document.getElementById("contact-msg");
  const api = import.meta.env.PUBLIC_API_URL ?? "";

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!msg) return;
    const data = Object.fromEntries(new FormData(form).entries());
    if (!data.name || !data.email || !data.message) {
      msg.textContent = "Please fill in your name, email, and message.";
      return;
    }
    const button = form.querySelector("button[type=submit]") as HTMLButtonElement | null;
    if (button) button.disabled = true;
    msg.textContent = "Sending…";
    try {
      const res = await fetch(`${api}/api/v1/contact`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error("request failed");
      form.reset();
      msg.textContent = "Thanks — we'll be in touch within one business day.";
    } catch {
      msg.textContent = "Something went wrong. Please email us directly and we'll jump on it.";
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
