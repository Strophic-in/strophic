---
import { articleSchema, breadcrumbSchema } from "@strophic/seo";
import { formatDate, readingTimeMinutes } from "@strophic/utils";
import { getCollection, render, type CollectionEntry } from "astro:content";
import Badge from "../../components/Badge.astro";
import Container from "../../components/Container.astro";
import CTASection from "../../components/CTASection.astro";
import Icon from "../../components/Icon.astro";
import Newsletter from "../../components/Newsletter.astro";
import Section from "../../components/Section.astro";
import { site } from "../../config/site";
import { getApiBlogPosts, type BlogPostView } from "../../lib/content";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Related {
  slug: string;
  title: string;
  description: string;
  category: string;
}

export async function getStaticPaths() {
  // Prefer CMS posts; fall back to the local MDX collection.
  const apiPosts = await getApiBlogPosts();
  if (apiPosts) {
    return apiPosts.map((view) => ({
      params: { slug: view.slug },
      props: {
        view,
        entry: null,
        related: apiPosts
          .filter((p) => p.slug !== view.slug)
          .slice(0, 2)
          .map((r) => ({ slug: r.slug, title: r.title, description: r.description, category: r.category })),
      },
    }));
  }
  const mdx = (await getCollection("blog")).filter((p) => !p.data.draft);
  return mdx.map((entry) => ({
    params: { slug: entry.id },
    props: {
      view: null,
      entry,
      related: mdx
        .filter((p) => p.id !== entry.id)
        .slice(0, 2)
        .map((r) => ({
          slug: r.id,
          title: r.data.title,
          description: r.data.description,
          category: r.data.category,
        })),
    },
  }));
}

interface Props {
  view: BlogPostView | null;
  entry: CollectionEntry<"blog"> | null;
  related: Related[];
}

const { view, entry, related } = Astro.props as Props;

// Normalise the two sources into one shape, and prepare the body renderer.
let meta: {
  title: string;
  description: string;
  category: string;
  tags: string[];
  author: string;
  publishedAt: Date;
  updatedAt: Date;
  reading: number;
};
let Content: Awaited<ReturnType<typeof render>>["Content"] | null = null;
let html: string | null = null;

if (view) {
  meta = {
    title: view.title,
    description: view.description,
    category: view.category,
    tags: view.tags,
    author: "Strophic",
    publishedAt: view.publishedAt,
    updatedAt: view.updatedAt,
    reading: view.readingTime,
  };
  html = view.html;
} else if (entry) {
  meta = {
    title: entry.data.title,
    description: entry.data.description,
    category: entry.data.category,
    tags: entry.data.tags,
    author: entry.data.author,
    publishedAt: entry.data.publishedAt,
    updatedAt: entry.data.updatedAt ?? entry.data.publishedAt,
    reading: readingTimeMinutes(entry.body ?? ""),
  };
  Content = (await render(entry)).Content;
} else {
  return Astro.redirect("/blog");
}

const slug = view ? view.slug : entry?.id;
const url = new URL(`/blog/${slug}`, site.url).toString();

const jsonLd = [
  articleSchema({
    headline: meta.title,
    description: meta.description,
    url,
    datePublished: meta.publishedAt.toISOString(),
    dateModified: meta.updatedAt.toISOString(),
    authorName: meta.author,
    publisherName: site.name,
    publisherLogo: new URL("/favicon-512.png", site.url).toString(),
  }),
  breadcrumbSchema([
    { name: "Home", url: site.url },
    { name: "Blog", url: new URL("/blog", site.url).toString() },
    { name: meta.title, url },
  ]),
];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  type="article"
  publishedTime={meta.publishedAt.toISOString()}
  modifiedTime={meta.updatedAt.toISOString()}
  jsonLd={jsonLd}
>
  <Section class="!pb-0">
    <Container>
      <a href="/blog" class="inline-flex items-center gap-1.5 text-sm text-ink-400 hover:text-ink-100">
        <Icon name="arrow-right" size={15} class="rotate-180" /> All posts
      </a>
      <div class="mx-auto mt-8 max-w-3xl">
        <div class="flex flex-wrap items-center gap-3">
          <Badge tone="brand">{meta.category}</Badge>
          <span class="font-mono text-xs text-ink-500">
            {formatDate(meta.publishedAt)} · {meta.reading} min read
          </span>
        </div>
        <h1 class="mt-5 text-4xl leading-tight sm:text-5xl">{meta.title}</h1>
        <p class="mt-5 text-lg leading-relaxed text-ink-400">{meta.description}</p>
        <div class="mt-6 flex flex-wrap gap-2">
          {meta.tags.map((t) => <span class="font-mono text-xs text-ink-500">#{t}</span>)}
        </div>
      </div>
    </Container>
  </Section>

  <Section class="!pt-10">
    <Container>
      <div
        class="prose dark:prose-invert mx-auto max-w-3xl prose-headings:font-serif prose-headings:font-medium prose-h2:text-2xl prose-a:text-brand-300 prose-a:no-underline hover:prose-a:underline prose-code:rounded prose-code:bg-ink-900 prose-code:px-1.5 prose-code:py-0.5 prose-code:font-normal prose-code:before:content-none prose-code:after:content-none prose-pre:rounded-2xl prose-pre:border prose-pre:border-ink-800 prose-pre:bg-ink-900"
      >
        {Content ? <Content /> : <Fragment set:html={html} />}
      </div>
    </Container>
  </Section>

  {
    related.length > 0 && (
      <Section class="border-t border-ink-900">
        <Container>
          <h2 class="text-2xl">Keep reading</h2>
          <div class="mt-8 grid gap-5 md:grid-cols-2">
            {related.map((r) => (
              <a
                href={`/blog/${r.slug}`}
                class="group rounded-2xl border border-ink-800/80 bg-ink-900/40 p-6 transition-colors hover:border-ink-700"
              >
                <Badge tone="brand">{r.category}</Badge>
                <h3 class="mt-4 text-lg font-medium text-ink-50 group-hover:text-white">{r.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-400">{r.description}</p>
              </a>
            ))}
          </div>
        </Container>
      </Section>
    )
  }

  <!-- Subscribe -->
  <Section class="!pt-0">
    <Container>
      <div
        data-reveal
        class="flex flex-col items-start justify-between gap-8 rounded-3xl border border-ink-800 bg-ink-900/40 p-8 sm:p-12 lg:flex-row lg:items-center"
      >
        <div class="max-w-md">
          <Badge tone="brand">Newsletter</Badge>
          <h2 class="mt-4 text-2xl sm:text-3xl">Enjoyed this post?</h2>
          <p class="mt-3 text-ink-400">
            Subscribe and get new posts straight to your inbox. No spam, unsubscribe anytime.
          </p>
        </div>
        <div class="w-full lg:w-auto">
          <Newsletter />
        </div>
      </div>
    </Container>
  </Section>

  <CTASection title="Have a project in mind?" />
</BaseLayout>
