---
import { articleSchema, breadcrumbSchema } from "@strophic/seo";
import { formatDate, readingTimeMinutes } from "@strophic/utils";
import { getCollection, render } from "astro:content";
import Badge from "../../components/Badge.astro";
import Container from "../../components/Container.astro";
import CTASection from "../../components/CTASection.astro";
import Icon from "../../components/Icon.astro";
import Section from "../../components/Section.astro";
import { site } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const { Content } = await render(post);
const reading = readingTimeMinutes(post.body ?? "");
const url = new URL(`/blog/${post.id}`, site.url).toString();
const related = posts
  .filter((p) => p.id !== post.id && !p.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 2);

const jsonLd = [
  articleSchema({
    headline: post.data.title,
    description: post.data.description,
    url,
    datePublished: post.data.publishedAt.toISOString(),
    dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
    authorName: post.data.author,
    publisherName: site.name,
    publisherLogo: new URL("/favicon.svg", site.url).toString(),
  }),
  breadcrumbSchema([
    { name: "Home", url: site.url },
    { name: "Blog", url: new URL("/blog", site.url).toString() },
    { name: post.data.title, url },
  ]),
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.publishedAt.toISOString()}
  modifiedTime={(post.data.updatedAt ?? post.data.publishedAt).toISOString()}
  jsonLd={jsonLd}
>
  <Section class="!pb-0">
    <Container>
      <a href="/blog" class="inline-flex items-center gap-1.5 text-sm text-ink-400 hover:text-ink-100">
        <Icon name="arrow-right" size={15} class="rotate-180" /> All posts
      </a>
      <div class="mx-auto mt-8 max-w-3xl">
        <div class="flex flex-wrap items-center gap-3">
          <Badge tone="brand">{post.data.category}</Badge>
          <span class="font-mono text-xs text-ink-500">
            {formatDate(post.data.publishedAt)} · {reading} min read
          </span>
        </div>
        <h1 class="mt-5 text-4xl leading-tight sm:text-5xl">{post.data.title}</h1>
        <p class="mt-5 text-lg leading-relaxed text-ink-400">{post.data.description}</p>
        <div class="mt-6 flex flex-wrap gap-2">
          {post.data.tags.map((t) => <span class="font-mono text-xs text-ink-500">#{t}</span>)}
        </div>
      </div>
    </Container>
  </Section>

  <Section class="!pt-10">
    <Container>
      <div
        class="prose prose-invert mx-auto max-w-3xl prose-headings:font-serif prose-headings:font-medium prose-h2:text-2xl prose-a:text-brand-300 prose-a:no-underline hover:prose-a:underline prose-code:rounded prose-code:bg-ink-900 prose-code:px-1.5 prose-code:py-0.5 prose-code:font-normal prose-code:before:content-none prose-code:after:content-none prose-pre:rounded-2xl prose-pre:border prose-pre:border-ink-800 prose-pre:bg-ink-900"
      >
        <Content />
      </div>
    </Container>
  </Section>

  {
    related.length > 0 && (
      <Section class="border-t border-ink-900">
        <Container>
          <h2 class="text-2xl">Keep reading</h2>
          <div class="mt-8 grid gap-5 md:grid-cols-2">
            {related.map((r) => (
              <a
                href={`/blog/${r.id}`}
                class="group rounded-2xl border border-ink-800/80 bg-ink-900/40 p-6 transition-colors hover:border-ink-700"
              >
                <Badge tone="brand">{r.data.category}</Badge>
                <h3 class="mt-4 text-lg font-medium text-ink-50 group-hover:text-white">{r.data.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-400">{r.data.description}</p>
              </a>
            ))}
          </div>
        </Container>
      </Section>
    )
  }

  <CTASection title="Have a project in mind?" />
</BaseLayout>
