// Strophic database schema - Phase 1 (identity, auth, settings, media).
// CMS/CRM models (Lead, BlogPost, Project, ...) arrive in later phases.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  // Prisma 7: connection URLs live in prisma.config.ts (migrations) and the
  // PrismaClient adapter (runtime). They are no longer set in the schema.
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  uploadedMedia       Media[]
  assignedLeads       Lead[]
  leadNotes           LeadNote[]
  posts               BlogPost[]

  @@map("users")
}

/// Rotating refresh tokens. Only a hash is stored; `family` groups a rotation
/// chain so reuse of an old token can revoke the whole family.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  family       String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

/// Single-use, expiring password reset tokens (hash stored, never the raw token).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Grouped site settings (company, social, email, seo, theme), one row per group.
model Setting {
  id        String   @id @default(cuid())
  group     String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model MediaFolder {
  id        String        @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime      @default(now())

  parent   MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children MediaFolder[] @relation("FolderTree")
  media    Media[]

  @@index([parentId])
  @@map("media_folders")
}

model Media {
  id           String   @id @default(cuid())
  key          String   @unique
  url          String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String?
  folderId     String?
  uploadedById String?
  createdAt    DateTime @default(now())

  folder     MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([folderId])
  @@index([uploadedById])
  @@map("media")
}

// ── CRM / Leads (Phase 3) ─────────────────────────────────────────────────────

enum LeadSource {
  INSTAGRAM
  X
  LINKEDIN
  GOOGLE
  REFERRAL
  DIRECT
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

/// A contact-form submission / sales lead.
model Lead {
  id           String       @id @default(cuid())
  name         String
  email        String
  company      String?
  message      String
  service      String?
  source       LeadSource   @default(DIRECT)
  status       LeadStatus   @default(NEW)
  priority     LeadPriority @default(MEDIUM)
  tags         String[]     @default([])
  assignedToId String?
  ip           String?
  userAgent    String?
  referrer     String?
  utm          Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assignedTo User?      @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  notes      LeadNote[]

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@map("leads")
}

/// A follow-up note on a lead, authored by an admin user.
model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@map("lead_notes")
}

enum SubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

/// Newsletter subscriber. `unsubscribeToken` lets a subscriber opt out without auth.
model NewsletterSubscriber {
  id               String           @id @default(cuid())
  email            String           @unique
  status           SubscriberStatus @default(SUBSCRIBED)
  source           String?
  unsubscribeToken String           @unique
  confirmedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
  @@map("newsletter_subscribers")
}

// ── Blog / CMS (Phase 4) ──────────────────────────────────────────────────────

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// A blog post. `content` is MDX/markdown source; category + tags are denormalized
/// strings (kept simple for v1; can be normalized to join tables later).
model BlogPost {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  excerpt         String
  content         String
  coverImage      String?
  category        String     @default("Engineering")
  tags            String[]   @default([])
  status          PostStatus @default(DRAFT)
  readingTime     Int        @default(1)
  metaTitle       String?
  metaDescription String?
  authorId        String?
  publishedAt     DateTime?
  // When a "new post" email was last sent to newsletter subscribers (null = never).
  // Guards the admin "Notify subscribers" action against accidental double-sends.
  notifiedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([publishedAt])
  @@map("blog_posts")
}

// ── Site content / CMS (Phase 4) ──────────────────────────────────────────────

/// A customer testimonial / social proof quote. `order` controls display order
/// (lower first); `featured` surfaces it on the homepage.
model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  author    String
  role      String
  company   String
  avatarUrl String?
  rating    Int?
  featured  Boolean  @default(false)
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([featured])
  @@map("testimonials")
}

/// A frequently-asked question. `category` groups questions on a page; `order`
/// controls display order within a group.
model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([category])
  @@map("faqs")
}

/// A portfolio project / case study. `accentFrom`/`accentTo` are the cover
/// gradient stops; `content` is the optional long-form case-study body (MDX).
model Project {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  summary    String
  category   String
  tags       String[] @default([])
  year       String
  accentFrom String   @default("#7c5cff")
  accentTo   String   @default("#3d2689")
  results    String[] @default([])
  coverImage String?
  logoImage  String?
  url        String?
  content    String?
  featured   Boolean  @default(false)
  published  Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published])
  @@index([featured])
  @@map("projects")
}

enum ProductStatus {
  LIVE
  BETA
  SOON
}

/// A Strophic-owned Micro-SaaS product. `content` is the optional detail body.
model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  tagline     String
  description String
  status      ProductStatus @default(BETA)
  url         String?
  logoImage   String?
  coverImage  String?
  pricing     String
  features    String[]      @default([])
  accentFrom  String        @default("#7c5cff")
  accentTo    String        @default("#3d2689")
  content     String?
  featured    Boolean       @default(false)
  published   Boolean       @default(true)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([published])
  @@index([featured])
  @@map("products")
}

/// A service offering. `workflow` is a JSON array of {title,description} steps;
/// `faqs` is a JSON array of {question,answer}.
model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  icon        String   @default("sparkles")
  image       String?
  title       String
  summary     String
  description String
  benefits    String[] @default([])
  stack       String[] @default([])
  workflow    Json     @default("[]")
  faqs        Json     @default("[]")
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([featured])
  @@map("services")
}

/// A team member. `links` is a JSON object of social/profile URLs.
model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String?
  avatarUrl String?
  links     Json     @default("{}")
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@map("team_members")
}

/// An editable, reorderable homepage section. `key` is a stable identifier
/// (e.g. "hero", "services"); `config` holds section-specific content.
model HomepageSection {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String?
  subtitle  String?
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("homepage_sections")
}

enum TodoStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TodoPriority {
  LOW
  MEDIUM
  HIGH
}

/// An internal todo / task. `reminderAt` is reserved for the Phase 6 reminder jobs.
model Todo {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TodoStatus   @default(TODO)
  priority    TodoPriority @default(MEDIUM)
  dueDate     DateTime?
  reminderAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([dueDate])
  @@map("todos")
}

// ── Analytics (Phase 6) ───────────────────────────────────────────────────────

/// A first-party analytics event (page view or custom event). Privacy-preserving:
/// `visitorHash` is a salted SHA-256 of IP+UA with a salt that rotates daily, so a
/// visitor cannot be tracked across days and no raw IP is ever stored.
model AnalyticsEvent {
  id          String   @id @default(cuid())
  type        String   @default("pageview")
  name        String?
  path        String
  referrer    String?
  visitorHash String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([path])
  @@map("analytics_events")
}
